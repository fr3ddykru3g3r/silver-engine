{
  "study_id": "IRIS_EPISODE_NORMALIZED_CAUSAL_BENCHMARK_V1",
  "status": "PREREGISTERED_DESIGN_ONLY_PROTECTED_OUTCOMES_UNTOUCHED",
  "created_date": "2026-09-09",
  "primary_question": "How much do repeated positive windows from the same physical SEP episode, already-active persistence states, and issue-time proton-history information alter apparent 24-hour SEP forecasting skill and model ranking?",
  "target": {
    "energy_threshold_mev": 10,
    "flux_threshold_pfu": 10,
    "forecast_horizon_hours": 24,
    "primary_semantics": "new_threshold_crossing_within_horizon",
    "already_active_is_onset_positive": false
  },
  "hypotheses": {
    "H1_event_multiplicity": "episode normalization materially changes at least one fixed model's TSS or matched-detection FAR",
    "H2_rank_instability": "at least one pair of fixed model families changes ordering between standard window occurrence scoring and episode-normalized new-onset scoring",
    "H3_proton_state_dependence": "removing direct proton-history features reduces onset skill more than persistence diagnostic skill",
    "null_rule": "If all hypotheses fail, retain the null result and do not tune architectures to manufacture an effect"
  },
  "evaluation_views": [
    "WINDOW_OCCURRENCE_STANDARD",
    "NEW_ONSET_CAUSAL",
    "EPISODE_NORMALIZED_ONSET",
    "PROTON_STATE_BLIND_ONSET",
    "PERSISTENCE_DIAGNOSTIC"
  ],
  "episode_weight_rule": {
    "positive_episode_total_weight": 1.0,
    "formula": "for each physical positive episode e, sum_i w_i(e)=1 over all eligible positive windows attached to e",
    "negative_weighting": "unit-window reference plus predeclared quiet-block bootstrap structure; no post-result prevalence reweighting"
  },
  "new_quantities": {
    "EMF": "positive_window_count / distinct_positive_episode_count",
    "ENS_metric": "metric_episode_normalized_onset - metric_window_occurrence_standard",
    "rank_stability_matrix": "all pairwise model ordering agreement/disagreement across standard and episode-normalized onset views"
  },
  "models": [
    "fit_prevalence_climatology",
    "causally_permitted_persistence_diagnostic",
    "elastic_net_logistic_regression_fixed",
    "xgboost_fixed",
    "existing_frozen_iris_candidate_if_exact_development_features_available"
  ],
  "model_search": {
    "hyperparameter_search_after_benchmark_delta_inspection": false,
    "architecture_expansion_in_v1": false,
    "selection_goal": "evaluation mechanism test, not score maximization"
  },
  "primary_metrics": [
    "TSS",
    "EPISODE_POD",
    "FAR_AT_MATCHED_EPISODE_POD",
    "MODEL_RANK_BY_TSS",
    "EMF"
  ],
